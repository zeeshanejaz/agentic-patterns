# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Langfuse Cloud (https://cloud.langfuse.com → project settings)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# MAF native OTEL → Langfuse OTLP
# Endpoint is {LANGFUSE_BASE_URL}/api/public/otel
# Headers: Authorization=Basic base64(public_key:secret_key)
# The maf-lab runner fills these from LANGFUSE_* if you leave them blank.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic
OTEL_SERVICE_NAME=sd-agentic
ENABLE_INSTRUMENTATION=true
ENABLE_SENSITIVE_DATA=true
